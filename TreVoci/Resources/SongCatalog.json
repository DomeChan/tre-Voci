      "lyrics": {
        "it": [
          { "time": 0.0, "text": "Fra Martino, campanaro" },
          { "time": 4.0, "text": "Dormi tu? Dormi tu?" },
          { "time": 8.0, "text": "Suona le campane" },
          { "time": 12.0, "text": "Din don dan, din don dan!" }
        ],
        "zh": [
